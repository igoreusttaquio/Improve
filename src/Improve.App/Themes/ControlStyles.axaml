<!-- Ajustes sobre os templates do Fluent (campos, combos) e classes utilitárias, sempre com tokens. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Improve.App.Controls"
        xmlns:ae="using:AvaloniaEdit">

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Campos de texto: surface-200, contorno border-strong, foco em focus-ring. -->
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBox.multiline">
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Editor de prompt: mesma moldura dos campos de texto. -->
  <Style Selector="Border.prompt-frame">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionFast}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="c|PromptEditor:editing Border.prompt-frame">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
  </Style>
  <Style Selector="Border.code-preview">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="c|CodeView.panel-code">
    <Setter Property="MaxHeight" Value="240" />
    <Setter Property="Margin" Value="16,16,8,16" />
  </Style>
  <Style Selector="ae|TextEditor.prompt">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Chips clicáveis das variáveis do prompt. -->
  <Style Selector="Button.variable">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.variable:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- Combos. -->
  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="AutoCompleteBox">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style Selector="AutoCompleteBox /template/ Border#PART_SuggestionsContainer">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>

  <!-- Superfícies. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource Space4Thickness}" />
  </Style>
  <!-- Entrada de página, lista e editor: fade com leve subida, sempre com o token motion-fast. -->
  <Style Selector=":is(Control).enter[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="{StaticResource MotionFast}" Easing="{StaticResource MotionEase}" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Cartões clicáveis destacam o contorno no hover. -->
  <Style Selector="Border.card.clickable">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionFast}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card.clickable:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Border.card.dragging">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{StaticResource MotionFast}" Easing="{StaticResource MotionEase}" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Popup e painel flutuantes (referencia-componentes.css: .imp-popup, .imp-panel). -->
  <Style Selector="Border.popup">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPopup}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowPopup}" />
    <Setter Property="Focusable" Value="True" />
    <!-- Dá para arrastar pelas áreas livres; os controles internos mantêm o próprio cursor. -->
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>
  <Style Selector="Border.popup.opening">
    <Style.Animations>
      <Animation Duration="{StaticResource MotionFast}" Easing="{StaticResource MotionEase}" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.98" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.98" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.popup-search">
    <Setter Property="Padding" Value="12,6,12,10" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.popup-foot">
    <Setter Property="Padding" Value="12,8,12,4" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
  </Style>
  <Style Selector="Border.row.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.row c|LucideIcon.row-icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <Style Selector="Border.row.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Border.row.selected c|LucideIcon.row-icon">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Panel.kbd">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.kbd > Border.kbd-bg">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
  </Style>
  <Style Selector="Panel.kbd > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <!-- Sobre o limão, o kbd usa on-accent a 12% (como no CSS de referência). -->
  <Style Selector="Border.row.selected Panel.kbd > Border.kbd-bg, Panel.kbd > Border.kbd-bg.on-accent">
    <Setter Property="Background" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Opacity" Value="0.12" />
  </Style>
  <Style Selector="Border.row.selected Panel.kbd > TextBlock, Button.primary Panel.kbd > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Border.panel-head">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.panel-foot">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.refine">
    <Setter Property="Margin" Value="16,0,16,12" />
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
  </Style>
  <Style Selector="Border.caret">
    <Setter Property="Width" Value="2" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="1,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <!-- Cursor do streaming pisca enquanto o texto chega. -->
  <Style Selector="Border.caret[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="51%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="c|LucideIcon.spin">
    <Style.Animations>
      <!-- Giro contínuo do indicador: não é transição, por isso não usa motion-fast. -->
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Campo sem moldura (busca do popup, refinar). -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Colunas da janela de configurações. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Surface100Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>
  <Style Selector="Border.panel.nav">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.tile > c|LucideIcon">
    <Setter Property="Size" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.card.dragging">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>

  <!-- Conteúdo de botão com ícone: ícone 16 + texto, gap 6. -->

  <Style Selector="StackPanel.button-content">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
</Styles>
