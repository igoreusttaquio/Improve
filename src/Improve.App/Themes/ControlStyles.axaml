<!-- Ajustes sobre os templates do Fluent (campos, combos) e classes utilitárias, sempre com tokens. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Improve.App.Controls">

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Campos de texto: surface-200, contorno border-strong, foco em focus-ring. -->
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBox.multiline">
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Combos. -->
  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="AutoCompleteBox">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style Selector="AutoCompleteBox /template/ Border#PART_SuggestionsContainer">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>

  <!-- Superfícies. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource Space4Thickness}" />
  </Style>
  <!-- Colunas da janela de configurações. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Surface100Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>
  <Style Selector="Border.panel.nav">
    <Setter Property="Background" Value="{DynamicResource Surface200Brush}" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.tile > c|LucideIcon">
    <Setter Property="Size" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource Surface300Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>

  <!-- Conteúdo de botão com ícone: ícone 16 + texto, gap 6. -->

  <Style Selector="StackPanel.button-content">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
</Styles>
