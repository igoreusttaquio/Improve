<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Improve.App.Resources"
             x:Class="Improve.App.App"
             Name="improve"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Dark" Source="/Themes/Tokens.Dark.axaml" />
        <ResourceInclude x:Key="Light" Source="/Themes/Tokens.Light.axaml" />
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/Typography.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon ToolTipText="improve" MacOSProperties.IsTemplateIcon="True">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{x:Static res:Strings.TrayOpenSettings}" Click="OnOpenSettings" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{x:Static res:Strings.TrayQuit}" Click="OnQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
