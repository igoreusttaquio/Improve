<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Improve.App.Controls"
             xmlns:vm="using:Improve.App.ViewModels"
             xmlns:res="using:Improve.App.Resources"
             x:Class="Improve.App.Views.ProvidersPage"
             x:DataType="vm:ProvidersPageViewModel">
  <Panel>
    <DockPanel Classes="enter" IsVisible="{Binding !IsEditing}" Margin="32,24">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <TextBlock Classes="title" Text="{x:Static res:Strings.NavProviders}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Command="{Binding AddCommand}">
          <StackPanel Classes="button-content">
            <c:LucideIcon Icon="plus" />
            <TextBlock Text="{x:Static res:Strings.ProvidersAdd}" />
          </StackPanel>
        </Button>
      </Grid>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16" IsVisible="{Binding IsKeyStorageInsecure}">
        <c:LucideIcon Icon="triangle-alert" Foreground="{DynamicResource WarningBrush}" />
        <TextBlock Classes="caption warning" Text="{x:Static res:Strings.KeyStorageInsecure}" TextWrapping="Wrap" />
      </StackPanel>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderCardViewModel">
              <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[ItemsControl].((vm:ProvidersPageViewModel)DataContext).EditCommand}" CommandParameter="{Binding}">
                <Border Classes="card clickable">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="tile">
                      <c:LucideIcon Icon="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="14" LineHeight="20" FontWeight="SemiBold" />
                      <TextBlock Classes="caption muted" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="chip" Classes.accent="{Binding HasKey}">
                      <TextBlock Text="{Binding KeyLabel}" />
                    </Border>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <ContentControl Classes="enter" Content="{Binding Editor}" IsVisible="{Binding IsEditing}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ProviderEditorViewModel">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="32,12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="danger" IsVisible="{Binding !IsNew}" Command="{Binding RemoveCommand}">
                  <StackPanel Classes="button-content">
                    <c:LucideIcon Icon="trash-2" />
                    <TextBlock Text="{x:Static res:Strings.Remove}" />
                  </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Classes="caption danger" Text="{Binding ValidationError}" VerticalAlignment="Center" Margin="16,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
                  <Button Classes="primary" Command="{Binding SaveCommand}">
                    <StackPanel Classes="button-content">
                      <c:LucideIcon Icon="check" />
                      <TextBlock Text="{x:Static res:Strings.Save}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer>
              <Grid Margin="32,24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="560" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="20">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost icon" Command="{Binding CancelCommand}" ToolTip.Tip="{x:Static res:Strings.Back}">
                      <c:LucideIcon Icon="arrow-left" />
                    </Button>
                    <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="field" Text="{x:Static res:Strings.FieldName}" />
                    <TextBox Text="{Binding Name}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="field" Text="{x:Static res:Strings.FieldKind}" />
                    <ComboBox ItemsSource="{x:Static vm:KindOption.All}" SelectedItem="{Binding Kind}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:KindOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="field" Text="{x:Static res:Strings.FieldBaseUrl}" />
                    <TextBox Text="{Binding BaseUrl}" Classes="code" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="field" Text="{x:Static res:Strings.FieldApiKey}" />
                    <TextBox Text="{Binding ApiKey}" PasswordChar="•" RevealPassword="False" Classes="code"
                             PlaceholderText="{x:Static res:Strings.ApiKeyPlaceholder}" />
                    <TextBlock Classes="caption muted" Text="{Binding KeyStatus}" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{Binding TestConnectionCommand}">
                      <StackPanel Classes="button-content">
                        <c:LucideIcon Icon="activity" />
                        <TextBlock Text="{x:Static res:Strings.TestConnection}" />
                      </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding TestMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <Panel>
                        <c:LucideIcon Icon="circle-check" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding TestOk}" />
                        <c:LucideIcon Icon="circle-x" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding !TestOk}" />
                      </Panel>
                      <TextBlock Classes="caption danger" Classes.success="{Binding TestOk}" Text="{Binding TestMessage}" TextWrapping="Wrap" MaxWidth="380" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Panel>
</UserControl>
