<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Improve.App.ViewModels"
             xmlns:res="using:Improve.App.Resources"
             xmlns:c="using:Improve.App.Controls"
             x:Class="Improve.App.Views.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <ScrollViewer Classes="enter">
    <Grid Margin="32,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="560" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="24">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Image Source="/Assets/AppIcon/improve-128.png" Width="64" Height="64" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="display" Text="improve" />
            <TextBlock Classes="body muted" Text="{x:Static res:Strings.AppTagline}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="12">
          <TextBlock Classes="caption muted" Text="{Binding Version}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding CheckForUpdatesCommand}" IsVisible="{Binding !IsUpdateAvailable}">
              <StackPanel Classes="button-content">
                <c:LucideIcon Icon="refresh-cw" />
                <TextBlock Text="{x:Static res:Strings.UpdateCheck}" />
              </StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}">
              <StackPanel Classes="button-content">
                <c:LucideIcon Icon="download" />
                <TextBlock Text="{x:Static res:Strings.UpdateInstall}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="body" Text="{Binding UpdateStatus}" IsVisible="{Binding UpdateStatus, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}"
                       Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderSubtleBrush}" />
          <TextBlock Classes="caption muted" Text="{x:Static res:Strings.UpdateClosesApp}" IsVisible="{Binding IsUpdateAvailable}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Classes="body" Text="{x:Static res:Strings.AboutPrivacy}" TextWrapping="Wrap" />

        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{x:Static res:Strings.AboutLicenses}" />
          <ItemsControl ItemsSource="{Binding Licenses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LicenseInfo">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Classes="body" Text="{Binding Component}" TextWrapping="Wrap" Margin="0,0,16,0" />
                  <TextBlock Grid.Column="1" Classes="body muted" Text="{Binding License}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
